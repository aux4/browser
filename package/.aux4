{
  "scope": "aux4",
  "name": "browser",
  "version": "1.0.23",
  "description": "Headless browser automation with daemon architecture and multi-agent session management",
  "license": "Apache-2.0",
  "git": "https://github.com/aux4/browser",
  "dependencies": [
    "aux4/playbook"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ],
    [
      "test:chromium --version",
      "linux:chromium",
      "cask:chromium"
    ]
  ],
  "tags": [
    "aux4",
    "browser",
    "playwright",
    "headless",
    "automation"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "browser",
          "execute": [
            "profile:browser"
          ],
          "help": {
            "text": "Headless browser automation"
          }
        }
      ]
    },
    {
      "name": "browser",
      "commands": [
        {
          "name": "start",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs start values(maxSessions,persistent,channel,browser,headed,localBrowser)"
          ],
          "help": {
            "text": "Start the browser daemon",
            "variables": [
              {
                "name": "maxSessions",
                "text": "Maximum concurrent sessions",
                "default": "20"
              },
              {
                "name": "persistent",
                "text": "Keep daemon running when all sessions close",
                "default": "false"
              },
              {
                "name": "channel",
                "text": "Browser channel (e.g. chrome, msedge)",
                "default": ""
              },
              {
                "name": "browser",
                "text": "Browser engine: chromium, firefox, webkit",
                "default": "chromium"
              },
              {
                "name": "headed",
                "text": "Run a visible (headed) browser window instead of headless — strongly reduces bot detection",
                "default": "false"
              },
              {
                "name": "localBrowser",
                "text": "Provision and launch the local browser at start; false = only when the first local session opens (remote-only daemons, e.g. a serverless VM using --provider cdp)",
                "default": "true"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs stop"
          ],
          "help": {
            "text": "Stop the browser daemon"
          }
        },
        {
          "name": "open",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs open values(url,timeout,width,height,output,video,snapshot,waitUntil,provider,awsProfile,awsRegion,cdpUrl)"
          ],
          "help": {
            "text": "Open a new browser session",
            "variables": [
              {
                "name": "url",
                "text": "URL to navigate to",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Session idle timeout (e.g. 10m, 1h)",
                "default": "10m"
              },
              {
                "name": "width",
                "text": "Viewport width",
                "default": "1280"
              },
              {
                "name": "height",
                "text": "Viewport height",
                "default": "720"
              },
              {
                "name": "output",
                "text": "Directory to save artifacts (screenshots, videos)",
                "default": ""
              },
              {
                "name": "video",
                "text": "Video recording mode: on, off, retain-on-failure",
                "default": "off"
              },
              {
                "name": "snapshot",
                "text": "Auto-snapshot mode on actions: off, auto, full",
                "default": "off"
              },
              {
                "name": "waitUntil",
                "text": "Navigation wait strategy: domcontentloaded, load, networkidle, settle",
                "default": "load"
              },
              {
                "name": "provider",
                "text": "Where to run the browser: local (default), cdp (attach to --cdpUrl; built in), or a provider name from an installed plugin (e.g. agentcore)",
                "default": "local"
              },
              {
                "name": "awsProfile",
                "text": "AWS profile to use when --provider requires AWS credentials (e.g. agentcore)",
                "default": ""
              },
              {
                "name": "awsRegion",
                "text": "AWS region to use when --provider requires an AWS region (e.g. agentcore)",
                "default": ""
              },
              {
                "name": "cdpUrl",
                "text": "CDP WebSocket URL (ws:// or wss://, e.g. a presigned URL from `browser presign`) to attach to when --provider cdp",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "close",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs close values(session)"
          ],
          "help": {
            "text": "Close a browser session",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              }
            ]
          }
        },
        {
          "name": "presign",
          "execute": [
            "if(provider==local) && echo 'browser presign: --provider must be a remote provider plugin (e.g. agentcore)' >&2 && exit 1 || true",
            "if(provider==cdp) && echo 'browser presign: --provider cdp already takes a URL; presign the provider that owns the session (e.g. agentcore)' >&2 && exit 1 || true",
            "aux4 browser ${provider}-presign param(session) param(timeout) param(expires) param(awsProfile) param(awsRegion)"
          ],
          "help": {
            "text": "Mint a short-lived CDP URL for a provider session (starting one if --session is empty) that a credential-less process can attach to with --provider cdp",
            "variables": [
              {
                "name": "provider",
                "text": "Provider plugin that owns the remote session (e.g. agentcore)",
                "default": "agentcore"
              },
              {
                "name": "session",
                "text": "Existing provider session id (e.g. agentcore:...) to re-presign; empty = start a new remote session",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Lifetime of a NEW remote session (e.g. 15m, 900s); ignored with --session",
                "default": ""
              },
              {
                "name": "expires",
                "text": "Presigned URL validity in seconds (provider maximum applies, AgentCore: 300)",
                "default": "300"
              },
              {
                "name": "awsProfile",
                "text": "AWS profile when the provider needs AWS credentials (e.g. agentcore)",
                "default": ""
              },
              {
                "name": "awsRegion",
                "text": "AWS region when the provider needs one (e.g. agentcore)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs list"
          ],
          "help": {
            "text": "List active browser sessions"
          }
        },
        {
          "name": "visit",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs visit values(session,url,waitUntil)"
          ],
          "help": {
            "text": "Navigate to a URL",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "url",
                "text": "URL to navigate to",
                "required": true
              },
              {
                "name": "waitUntil",
                "text": "Navigation wait strategy: domcontentloaded, load, networkidle, settle",
                "default": "load"
              }
            ]
          }
        },
        {
          "name": "back",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs back values(session)"
          ],
          "help": {
            "text": "Go back in browser history",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              }
            ]
          }
        },
        {
          "name": "forward",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs forward values(session)"
          ],
          "help": {
            "text": "Go forward in browser history",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              }
            ]
          }
        },
        {
          "name": "reload",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs reload values(session)"
          ],
          "help": {
            "text": "Reload the current page",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              }
            ]
          }
        },
        {
          "name": "click",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs click values(session,name,role,index,ref,within)"
          ],
          "help": {
            "text": "Click an element by role+name or snapshot ref index",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the element",
                "default": ""
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "button"
              },
              {
                "name": "index",
                "text": "1-based index when multiple elements match",
                "default": ""
              },
              {
                "name": "ref",
                "text": "Snapshot ref index (from snapshot command), overrides name/role",
                "default": ""
              },
              {
                "name": "within",
                "text": "Optional iframe CSS selector to click inside (frameLocator); nest with >>>",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "click-selector",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs click-selector values(session,selector,within)"
          ],
          "help": {
            "text": "Click an element by CSS selector",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector to click",
                "required": true
              },
              {
                "name": "within",
                "text": "Optional iframe CSS selector to click inside (frameLocator); nest with >>>",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "mouse",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs mouse values(session,action,x,y,steps,selector,within)"
          ],
          "help": {
            "text": "Drive the real mouse at viewport coordinates with a human-like trajectory",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "action",
                "text": "move | click | down | up",
                "default": "click"
              },
              {
                "name": "x",
                "text": "Target viewport X coordinate (ignored when --selector is given)",
                "default": "0"
              },
              {
                "name": "y",
                "text": "Target viewport Y coordinate (ignored when --selector is given)",
                "default": "0"
              },
              {
                "name": "steps",
                "text": "Number of intermediate move steps (higher = smoother/slower)",
                "default": "20"
              },
              {
                "name": "selector",
                "text": "Optional CSS selector to aim at the element's center instead of x/y",
                "default": ""
              },
              {
                "name": "within",
                "text": "Optional iframe CSS selector to resolve the selector inside (frameLocator)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "click-text",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs click-text values(session,text,index,within)"
          ],
          "help": {
            "text": "Click an element by its text content",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "text",
                "text": "Text content to find and click",
                "required": true
              },
              {
                "name": "index",
                "text": "1-based index when multiple elements match",
                "default": ""
              },
              {
                "name": "within",
                "text": "Optional iframe CSS selector to click inside (frameLocator); nest with >>>",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "type",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs type values(session,name*,value*,role,ref,within)"
          ],
          "help": {
            "text": "Type text into an input field",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the field",
                "default": "",
                "multiple": true
              },
              {
                "name": "value",
                "text": "Text to type or secret:// reference",
                "required": true,
                "multiple": true
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "textbox"
              },
              {
                "name": "ref",
                "text": "Snapshot ref index (from snapshot command), overrides name/role",
                "default": ""
              },
              {
                "name": "within",
                "text": "Optional iframe CSS selector to scope into (frameLocator); nest with >>>",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "scroll",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs scroll values(session,direction,amount,to)"
          ],
          "help": {
            "text": "Scroll the page",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "direction",
                "text": "Scroll direction",
                "default": "down"
              },
              {
                "name": "amount",
                "text": "Scroll amount in pixels",
                "default": "500"
              },
              {
                "name": "to",
                "text": "Scroll to element by text content",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "select",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs select values(session,name,value,role,ref)"
          ],
          "help": {
            "text": "Select an option from a dropdown",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the select element",
                "default": ""
              },
              {
                "name": "value",
                "text": "Option value to select",
                "required": true
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "combobox"
              },
              {
                "name": "ref",
                "text": "Snapshot ref index (from snapshot command), overrides name/role",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "check",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs check values(session,name,role,ref)"
          ],
          "help": {
            "text": "Check a checkbox",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the checkbox",
                "default": ""
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "checkbox"
              },
              {
                "name": "ref",
                "text": "Snapshot ref index (from snapshot command), overrides name/role",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "uncheck",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs uncheck values(session,name,role,ref)"
          ],
          "help": {
            "text": "Uncheck a checkbox",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the checkbox",
                "default": ""
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "checkbox"
              },
              {
                "name": "ref",
                "text": "Snapshot ref index (from snapshot command), overrides name/role",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "hover",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs hover values(session,name,role)"
          ],
          "help": {
            "text": "Hover over an element",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the element",
                "required": true
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "button"
              }
            ]
          }
        },
        {
          "name": "press",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs press values(session,key,selector)"
          ],
          "help": {
            "text": "Press a keyboard key",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "key",
                "text": "Key to press (e.g. Enter, Tab, Escape, ArrowDown)",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector to focus before pressing key",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "clear",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs clear values(session,name,role)"
          ],
          "help": {
            "text": "Clear an input field",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name of the field",
                "required": true
              },
              {
                "name": "role",
                "text": "ARIA role",
                "default": "textbox"
              }
            ]
          }
        },
        {
          "name": "upload",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs upload values(session,name,file)"
          ],
          "help": {
            "text": "Upload a file",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "name",
                "text": "Accessible name or label of the file input",
                "required": true
              },
              {
                "name": "file",
                "text": "Path to the file to upload",
                "required": true
              }
            ]
          }
        },
        {
          "name": "content",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs content values(session,selector,format,output)"
          ],
          "help": {
            "text": "Get page content",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector",
                "default": ""
              },
              {
                "name": "format",
                "text": "Output format: markdown, html, text",
                "default": "markdown"
              },
              {
                "name": "output",
                "text": "Write content to file instead of stdout, returns path + summary",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "screenshot",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs screenshot values(session,output,fullPage)"
          ],
          "help": {
            "text": "Take a screenshot",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "output",
                "text": "Output file path",
                "default": "screenshot.png"
              },
              {
                "name": "fullPage",
                "text": "Capture full page",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "read",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs read values(url,session,format,waitUntil,output)"
          ],
          "help": {
            "text": "One-shot page read: navigate, settle, and return content + status",
            "variables": [
              {
                "name": "url",
                "text": "URL to read",
                "required": true
              },
              {
                "name": "session",
                "text": "Existing session ID to reuse (optional)",
                "default": ""
              },
              {
                "name": "format",
                "text": "Content format: markdown, html, text",
                "default": "markdown"
              },
              {
                "name": "waitUntil",
                "text": "Navigation wait strategy: domcontentloaded, load, networkidle, settle",
                "default": "load"
              },
              {
                "name": "output",
                "text": "Write content to file instead of inline, returns path + summary",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "wait",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs wait values(session,selector,timeout)"
          ],
          "help": {
            "text": "Wait for a condition: CSS selector, text=..., url=..., networkidle, or settle",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "selector",
                "text": "Wait target: CSS selector, text=..., url=..., networkidle, or settle",
                "required": true
              },
              {
                "name": "timeout",
                "text": "Timeout in milliseconds",
                "default": "10000"
              }
            ]
          }
        },
        {
          "name": "expect",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs expect values(session,selector,assertion,expected,timeout)"
          ],
          "help": {
            "text": "Assert expectations on page elements",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector",
                "required": true
              },
              {
                "name": "assertion",
                "text": "Assertion type: have_text, be_visible, exist, not_exist, have_attribute, have_count",
                "required": true
              },
              {
                "name": "expected",
                "text": "Expected value (for have_text, have_attribute, have_count)",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Timeout in milliseconds",
                "default": "5000"
              }
            ]
          }
        },
        {
          "name": "click-item",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs click-item values(session,item,selector)"
          ],
          "help": {
            "text": "Click a list item by text or index",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "item",
                "text": "Item text or 1-based index",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector for the list container",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "expect-list",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs expect-list values(session,assertion,expected,selector,timeout)"
          ],
          "help": {
            "text": "Assert expectations on lists",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "assertion",
                "text": "Assertion type: at_least, contains",
                "required": true
              },
              {
                "name": "expected",
                "text": "Expected value (count or text)",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector for the list container",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Timeout in milliseconds",
                "default": "5000"
              }
            ]
          }
        },
        {
          "name": "get-items",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs get-items values(session,selector)"
          ],
          "help": {
            "text": "Get text content of list items",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector for the list container",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "execute",
          "execute": [
            "aux4 playbook execute ${instructions} --session ${session}"
          ],
          "help": {
            "text": "Execute a playbook script with browser actions",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "instructions",
                "text": "Path to playbook script file",
                "required": true
              }
            ]
          }
        },
        {
          "name": "eval",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs eval values(session,script)"
          ],
          "help": {
            "text": "Evaluate JavaScript in the page",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "script",
                "text": "JavaScript code to evaluate",
                "required": true
              }
            ]
          }
        },
        {
          "name": "cookies",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs cookies values(session,export,import)"
          ],
          "help": {
            "text": "Manage cookies",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "export",
                "text": "Export cookies to file",
                "default": ""
              },
              {
                "name": "import",
                "text": "Import cookies from file",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "download",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs download values(session,url,output)"
          ],
          "help": {
            "text": "Download a file",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "url",
                "text": "URL to download",
                "required": true
              },
              {
                "name": "output",
                "text": "Output file path",
                "required": true
              }
            ]
          }
        },
        {
          "name": "save-pdf",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs save-pdf values(session,output,format,printBackground)"
          ],
          "help": {
            "text": "Save the current page as a PDF",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "output",
                "text": "Output file path",
                "default": "page.pdf"
              },
              {
                "name": "format",
                "text": "Paper format: Letter, A4, Legal, Tabloid",
                "default": ""
              },
              {
                "name": "printBackground",
                "text": "Include background graphics",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "set-scope",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs set-scope values(session,selector)"
          ],
          "help": {
            "text": "Set element scope for subsequent commands",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "selector",
                "text": "CSS selector to scope to",
                "required": true
              }
            ]
          }
        },
        {
          "name": "clear-scope",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs clear-scope values(session)"
          ],
          "help": {
            "text": "Clear element scope",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              }
            ]
          }
        },
        {
          "name": "set-snapshot",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs set-snapshot values(session,mode)"
          ],
          "help": {
            "text": "Set snapshot mode for the session",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "mode",
                "text": "Snapshot mode: off, auto, full",
                "required": true
              }
            ]
          }
        },
        {
          "name": "new-tab",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs new-tab values(session,url)"
          ],
          "help": {
            "text": "Open a new tab",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "url",
                "text": "URL to open in new tab",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "switch-tab",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs switch-tab values(session,tab)"
          ],
          "help": {
            "text": "Switch to a tab",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "tab",
                "text": "Tab index",
                "required": true
              }
            ]
          }
        },
        {
          "name": "close-tab",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs close-tab values(session,tab)"
          ],
          "help": {
            "text": "Close a tab",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "tab",
                "text": "Tab index",
                "required": true
              }
            ]
          }
        },
        {
          "name": "list-tabs",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs list-tabs values(session)"
          ],
          "help": {
            "text": "List tabs in a session",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              }
            ]
          }
        },
        {
          "name": "run",
          "execute": [
            "aux4 browser start --persistent true --channel \"${channel}\" --browser \"${browser}\" >/dev/null 2>&1 & sleep 3; SESSION=$(aux4 browser open --url \"${url}\" --width \"${width}\" --height \"${height}\" --output \"${output}\" --video \"${video}\" 2>/dev/null); aux4 playbook execute ${instructions} --session $SESSION; EXIT=$?; aux4 browser close --session $SESSION >/dev/null 2>&1; aux4 browser stop >/dev/null 2>&1; exit $EXIT"
          ],
          "help": {
            "text": "Run a playbook script (one-shot mode)",
            "variables": [
              {
                "name": "url",
                "text": "Initial URL to navigate to",
                "default": ""
              },
              {
                "name": "width",
                "text": "Viewport width",
                "default": "1280"
              },
              {
                "name": "height",
                "text": "Viewport height",
                "default": "720"
              },
              {
                "name": "instructions",
                "text": "Path to playbook script file",
                "required": true
              },
              {
                "name": "output",
                "text": "Directory to save artifacts (screenshots, videos)",
                "default": ""
              },
              {
                "name": "video",
                "text": "Video recording mode: on, off, retain-on-failure",
                "default": "off"
              },
              {
                "name": "channel",
                "text": "Browser channel (e.g. chrome, msedge)",
                "default": ""
              },
              {
                "name": "browser",
                "text": "Browser engine: chromium, firefox, webkit",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "component",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs component values(session,type,action,name,row,col,where,item,field,fields,value,tab,path,title,timeout)"
          ],
          "help": {
            "text": "Interact with a UI component structurally (table, form, list, nav, menu, dialog, tab, tree, card)",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "type",
                "text": "Component type: table, form, list, nav, menu, dialog, tab, tree, card",
                "required": true
              },
              {
                "name": "action",
                "text": "Action: locate, click, hover, read, count, bounds, fill, scroll",
                "default": "locate"
              },
              {
                "name": "name",
                "text": "Accessible name of the component",
                "default": ""
              },
              {
                "name": "row",
                "text": "Table row (1-based index or matching text)",
                "default": ""
              },
              {
                "name": "col",
                "text": "Table column (1-based index or header name)",
                "default": ""
              },
              {
                "name": "where",
                "text": "Row filter for table, e.g. \"Name=Acme\"",
                "default": ""
              },
              {
                "name": "item",
                "text": "List item (1-based index or text)",
                "default": ""
              },
              {
                "name": "field",
                "text": "Form field label",
                "default": ""
              },
              {
                "name": "fields",
                "text": "JSON map of form fields to fill",
                "default": ""
              },
              {
                "name": "value",
                "text": "Value for fill action",
                "default": ""
              },
              {
                "name": "tab",
                "text": "Tab index or name (for tab component)",
                "default": ""
              },
              {
                "name": "path",
                "text": "Tree path, e.g. \"Root>Child>Leaf\"",
                "default": ""
              },
              {
                "name": "title",
                "text": "Card title",
                "default": ""
              },
              {
                "name": "timeout",
                "text": "Timeout in milliseconds",
                "default": "5000"
              }
            ]
          }
        },
        {
          "name": "snapshot",
          "execute": [
            "node ${packageDir}/lib/aux4-browser.mjs snapshot values(session,mode,format,output)"
          ],
          "help": {
            "text": "Return an accessibility snapshot of the current page",
            "variables": [
              {
                "name": "session",
                "text": "Session ID",
                "required": true
              },
              {
                "name": "mode",
                "text": "Snapshot mode: auto, full",
                "default": "auto"
              },
              {
                "name": "format",
                "text": "Output format: json, text",
                "default": "json"
              },
              {
                "name": "output",
                "text": "Write snapshot to file instead of stdout, returns path + summary",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "mock-open",
          "private": true,
          "execute": [
            "echo '{\"token\":\"tok-abc\",\"wsUrl\":\"ws://127.0.0.1:1/mock\",\"headers\":{}}'"
          ],
          "help": {
            "text": "TEST FIXTURE ONLY: fake provider-open used by browser package tests to exercise the provider seam without AWS. Never a real provider."
          }
        },
        {
          "name": "mock-attach",
          "private": true,
          "execute": [
            "echo '{\"wsUrl\":\"ws://127.0.0.1:1/mock\",\"headers\":{}}'"
          ],
          "help": {
            "text": "TEST FIXTURE ONLY: fake provider-attach used by browser package tests to exercise the provider seam without AWS. Never a real provider.",
            "variables": [
              {
                "name": "token",
                "text": "opaque token (ignored by the fixture)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "mock-close",
          "private": true,
          "execute": [
            "echo '{\"status\":\"closed\"}'"
          ],
          "help": {
            "text": "TEST FIXTURE ONLY: fake provider-close used by browser package tests to exercise the provider seam without AWS. Never a real provider.",
            "variables": [
              {
                "name": "token",
                "text": "opaque token (ignored by the fixture)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "broken-open",
          "private": true,
          "execute": [
            "echo 'not-json'"
          ],
          "help": {
            "text": "TEST FIXTURE ONLY: a provider-open that returns invalid JSON, used to test that the provider seam fails loudly instead of falling back to a local browser."
          }
        }
      ]
    },
    {
      "name": "playbook:actions",
      "commands": [
        {
          "name": "browser",
          "execute": [
            "cat ${packageDir}/actions/browser.yaml"
          ],
          "help": {
            "text": "Browser automation actions for playbook"
          }
        }
      ]
    }
  ]
}
